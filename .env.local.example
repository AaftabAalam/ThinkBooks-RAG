DATABASE_URL=postgresql://apple@localhost:5432/rag
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=50
MILVUS_URI=data/milvus.db
REDIS_URL=redis://localhost:6379/0
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_SEQ_LENGTH=8192
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
LLM_MODEL=mlx-community/Qwen3.5-4B-MLX-4bit
# Semantic answer reuse can return an answer to a different question.
SEMANTIC_CACHE_ENABLED=false
# OCR image-bearing PDFs and embedded Office images. Requires Tesseract.
PDF_DO_OCR=true
OCR_LANGUAGE=eng
